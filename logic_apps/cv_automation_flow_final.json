{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_new_email_arrives_(V3)": {
        "inputs": {
          "fetch": {
            "method": "get",
            "pathTemplate": {
              "template": "/v3/Mail/OnNewEmail"
            },
            "queries": {
              "fetchOnlyWithAttachment": true,
              "folderPath": "Id::AQMkADA2YTU5NjVmLWU3MjgtNDk5AS1hN2ExLWNkNWNhMjRkM2ZlNAAuAAADUkGdCUm1vEq75ji2GhgRwgEA_82QtF4kQUKmGgt8NH9htAAAAgEMAAAA",
              "includeAttachments": true
            }
          },
          "host": {
            "connection": {
              "name": "@parameters('$connections')['office365']['connectionId']"
            }
          },
          "subscribe": {
            "body": {
              "NotificationUrl": "@listCallbackUrl()"
            },
            "method": "post",
            "pathTemplate": {
              "template": "/GraphMailSubscriptionPoke/$subscriptions"
            },
            "queries": {
              "fetchOnlyWithAttachment": true,
              "folderPath": "Id::AQMkADA2YTU5NjVmLWU3MjgtNDk5AS1hN2ExLWNkNWNhMjRkM2ZlNAAuAAADUkGdCUm1vEq75ji2GhgRwgEA_82QtF4kQUKmGgt8NH9htAAAAgEMAAAA"
            }
          }
        },
        "metadata": {
          "Id::AQMkADA2YTU5NjVmLWU3MjgtNDk5AS1hN2ExLWNkNWNhMjRkM2ZlNAAuAAADUkGdCUm1vEq75ji2GhgRwgEA_82QtF4kQUKmGgt8NH9htAAAAgEMAAAA": "Inbox"
        },
        "runtimeConfiguration": {
          "concurrency": {
            "runs": 1
          }
        },
        "splitOn": "@triggerBody()?['value']",
        "type": "ApiConnectionNotification"
      }
    },
    "actions": {
      "Initialize_MessageId": {
        "type": "InitializeVariable",
        "runAfter": {},
        "inputs": {
          "variables": [
            {
              "name": "MessageId",
              "type": "string",
              "value": "@{coalesce(triggerBody()?['internetMessageId'], triggerBody()?['id'])}"
            }
          ]
        }
      },
      "Initialize_ExtraDocs": {
        "type": "InitializeVariable",
        "runAfter": {
          "Initialize_MessageId": [
            "Succeeded"
          ]
        },
        "inputs": {
          "variables": [
            {
              "name": "ExtraDocs",
              "type": "array",
              "value": []
            }
          ]
        }
      },
      "Condition": {
        "actions": {
          "For_each": {
            "actions": {
              "Condition_1": {
                "actions": {
                  "Call_CV_Extract_API": {
                    "inputs": {
                      "method": "POST",
                      "uri": "@parameters('djangoApiUrl')",
                      "headers": {
                        "Content-Type": "application/json",
                        "X-Api-Key": "@parameters('djangoApiKey')"
                      },
                      "body": {
                        "content_base64": "@body('Get_Attachment_(V2)')?['contentBytes']",
                        "email_subject": "@triggerBody()?['subject']",
                        "email_body": "@outputs('Html_to_text')?['body']",
                        "filename": "@body('Get_Attachment_(V2)')?['name']"
                      },
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 2,
                        "interval": "PT10S"
                      }
                    },
                    "runAfter": {},
                    "type": "Http"
                  },
                  "Parse_extract_response": {
                    "inputs": {
                      "content": "@body('Call_CV_Extract_API')",
                      "schema": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          },
                          "matched_job_id": {
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "source": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "full_name": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "email": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "phone": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "dob": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "current_location": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "linkedin": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "portfolio_url": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "qualification": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "last_role": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "last_company": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "total_experience_years": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "skills": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "notice_period": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "expected_salary": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "current_salary": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "role_applied": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "cv_summary": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "experience": {
                            "type": "array"
                          },
                          "education": {
                            "type": "array"
                          },
                          "document_type": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    },
                    "runAfter": {
                      "Call_CV_Extract_API": [
                        "Succeeded"
                      ]
                    },
                    "type": "ParseJson"
                  },
                  "Create_file_1": {
                    "inputs": {
                      "body": "@base64ToBinary(body('Get_Attachment_(V2)')?['contentBytes'])",
                      "host": {
                        "connection": {
                          "name": "@parameters('$connections')['sharepointonline-1']['connectionId']"
                        }
                      },
                      "method": "post",
                      "path": "/datasets/@{encodeURIComponent(encodeURIComponent('https://netorg519925.sharepoint.com/sites/TeamHR'))}/files",
                      "queries": {
                        "folderPath": "/Shared Documents/General/HR - Docs/TurnB - HR/Recruitment/Resume Received",
                        "name": "@body('Get_Attachment_(V2)')?['name']",
                        "queryParametersSingleEncoded": true
                      }
                    },
                    "runAfter": {
                      "Parse_extract_response": [
                        "Succeeded",
                        "Failed",
                        "TimedOut",
                        "Skipped"
                      ]
                    },
                    "runtimeConfiguration": {
                      "contentTransfer": {
                        "transferMode": "Chunked"
                      }
                    },
                    "type": "ApiConnection"
                  },
                  "Create_blob": {
                    "inputs": {
                      "body": "@base64ToBinary(body('Get_Attachment_(V2)')?['contentBytes'])",
                      "host": {
                        "connection": {
                          "name": "@parameters('$connections')['azureblob']['connectionId']"
                        }
                      },
                      "method": "post",
                      "path": "/datasets/default/files",
                      "queries": {
                        "folderPath": "/candidate-cvs",
                        "name": "@{outputs('Blob_name')}",
                        "queryParametersSingleEncoded": true
                      }
                    },
                    "runAfter": {
                      "Parse_extract_response": [
                        "Succeeded",
                        "Failed",
                        "TimedOut",
                        "Skipped"
                      ],
                      "Blob_name": [
                        "Succeeded"
                      ]
                    },
                    "runtimeConfiguration": {
                      "contentTransfer": {
                        "transferMode": "Chunked"
                      }
                    },
                    "type": "ApiConnection"
                  },
                  "Create_sharing_link_for_a_file_or_folder": {
                    "inputs": {
                      "body": {
                        "scope": "organization",
                        "type": "edit"
                      },
                      "host": {
                        "connection": {
                          "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                        }
                      },
                      "method": "post",
                      "path": "/datasets/@{encodeURIComponent(encodeURIComponent('https://netorg519925.sharepoint.com/sites/TeamHR'))}/codeless/_api/v2.0/sites/root/lists/@{encodeURIComponent(encodeURIComponent('55178891-31a8-46cc-9a03-23970fab1fcd'))}/items/@{encodeURIComponent(encodeURIComponent(body('Create_file_1')?['ItemId']))}/driveItem/createLink"
                    },
                    "runAfter": {
                      "Create_file_1": [
                        "Succeeded"
                      ]
                    },
                    "type": "ApiConnection"
                  },
                  "Filter_array": {
                    "inputs": {
                      "from": "@body('List_rows_present_in_a_table')?['value']",
                      "where": "@endsWith(triggerBody()?['from'], item()?['EMAIL IDs'])"
                    },
                    "runAfter": {
                      "List_rows_present_in_a_table": [
                        "Succeeded"
                      ]
                    },
                    "type": "Query"
                  },
                  "List_rows_present_in_a_table": {
                    "inputs": {
                      "host": {
                        "connection": {
                          "name": "@parameters('$connections')['excelonlinebusiness']['connectionId']"
                        }
                      },
                      "method": "get",
                      "path": "/drives/@{encodeURIComponent('b!wKeoKu8tDk6vvSyxANYWq9--QEGIUO9Hn9Ho_75eTFyRiBdVqDHMRpoDI5cPqx_N')}/files/@{encodeURIComponent(encodeURIComponent('017OMLUA3R2KFNYYBHNJGYGHHFXWIJSHU6'))}/tables/@{encodeURIComponent('{7A04E27E-3A4E-4D27-8DB4-B7ECA0FEDBAA}')}/items",
                      "queries": {
                        "source": "groups/d2a9fd4f-4485-4772-976c-877eca4547e2"
                      }
                    },
                    "metadata": {
                      "017OMLUA3R2KFNYYBHNJGYGHHFXWIJSHU6": "/General/HR - Docs/TurnB - HR/Recruitment/Resume Received Data/Book.xlsx"
                    },
                    "runAfter": {
                      "Create_sharing_link_for_a_file_or_folder": [
                        "Succeeded"
                      ]
                    },
                    "type": "ApiConnection"
                  },
                  "Blob_name": {
                    "type": "Compose",
                    "runAfter": {},
                    "inputs": "@{formatDateTime(utcNow(), 'yyyyMMddHHmmss')}-@{substring(guid(), 0, 8)}-@{body('Get_Attachment_(V2)')?['name']}"
                  },
                  "Condition_Is_CV": {
                    "type": "If",
                    "runAfter": {
                      "Create_blob": [
                        "Succeeded",
                        "Failed",
                        "TimedOut",
                        "Skipped"
                      ],
                      "Filter_array": [
                        "Succeeded"
                      ]
                    },
                    "expression": {
                      "and": [
                        {
                          "equals": [
                            "@if(empty(body('Parse_extract_response')?['document_type']), not(contains(toLower(body('Get_Attachment_(V2)')?['name']), 'cover')), equals(body('Parse_extract_response')?['document_type'], 'cv'))",
                            true
                          ]
                        }
                      ]
                    },
                    "actions": {
                      "Condition_2": {
                        "actions": {
                          "Execute_stored_procedure_(V2)": {
                            "inputs": {
                              "body": {
                                "cv_link": "@if(equals(actions('Create_blob')?['status'], 'Succeeded'), concat('https://turnbhrmscvs.blob.core.windows.net/candidate-cvs/', encodeURIComponent(outputs('Blob_name'))), body('Create_sharing_link_for_a_file_or_folder')?['link']?['webUrl'])",
                                "cv_summary": "@coalesce(body('Parse_extract_response')?['cv_summary'], '')",
                                "education": "@body('Parse_extract_response')?['qualification']",
                                "email": "@coalesce(body('Parse_extract_response')?['email'], concat('pending-', guid(), '@placeholder.local'))",
                                "full_name": "@coalesce(body('Parse_extract_response')?['full_name'], body('Get_Attachment_(V2)')?['name'], 'Unnamed Candidate')",
                                "mail_date": "@triggerOutputs()?['body/receivedDateTime']",
                                "phone": "@body('Parse_extract_response')?['phone']",
                                "role_applied": "@body('Parse_extract_response')?['role_applied']",
                                "matched_job_id": "@body('Parse_extract_response')?['matched_job_id']",
                                "source": "@first(body('Filter_array'))?['Agency Name']",
                                "linkedin": "@body('Parse_extract_response')?['linkedin']",
                                "portfolio_url": "@body('Parse_extract_response')?['portfolio_url']",
                                "current_location": "@body('Parse_extract_response')?['current_location']",
                                "dob": "@body('Parse_extract_response')?['dob']",
                                "last_role": "@body('Parse_extract_response')?['last_role']",
                                "last_company": "@body('Parse_extract_response')?['last_company']",
                                "total_experience_years": "@body('Parse_extract_response')?['total_experience_years']",
                                "skills": "@body('Parse_extract_response')?['skills']",
                                "notice_period": "@body('Parse_extract_response')?['notice_period']",
                                "expected_salary": "@body('Parse_extract_response')?['expected_salary']",
                                "current_salary": "@body('Parse_extract_response')?['current_salary']",
                                "experience_json": "@string(coalesce(body('Parse_extract_response')?['experience'], json('[]')))",
                                "education_json": "@string(coalesce(body('Parse_extract_response')?['education'], json('[]')))",
                                "source_message_id": "@variables('MessageId')"
                              },
                              "host": {
                                "connection": {
                                  "name": "@parameters('$connections')['sql']['connectionId']"
                                }
                              },
                              "method": "post",
                              "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('default'))},@{encodeURIComponent(encodeURIComponent('default'))}/procedures/@{encodeURIComponent(encodeURIComponent('[dbo].[sp_intake_add_candidate]'))}"
                            },
                            "type": "ApiConnection"
                          }
                        },
                        "else": {
                          "actions": {
                            "Execute_stored_procedure_(V2)_1": {
                              "inputs": {
                                "body": {
                                  "cv_link": "@if(equals(actions('Create_blob')?['status'], 'Succeeded'), concat('https://turnbhrmscvs.blob.core.windows.net/candidate-cvs/', encodeURIComponent(outputs('Blob_name'))), body('Create_sharing_link_for_a_file_or_folder')?['link']?['webUrl'])",
                                  "cv_summary": "@coalesce(body('Parse_extract_response')?['cv_summary'], '')",
                                  "education": "@body('Parse_extract_response')?['qualification']",
                                  "email": "@coalesce(body('Parse_extract_response')?['email'], concat('pending-', guid(), '@placeholder.local'))",
                                  "full_name": "@coalesce(body('Parse_extract_response')?['full_name'], body('Get_Attachment_(V2)')?['name'], 'Unnamed Candidate')",
                                  "mail_date": "@triggerOutputs()?['body/receivedDateTime']",
                                  "phone": "@body('Parse_extract_response')?['phone']",
                                  "role_applied": "@body('Parse_extract_response')?['role_applied']",
                                  "matched_job_id": "@body('Parse_extract_response')?['matched_job_id']",
                                  "source": "@coalesce(body('Parse_extract_response')?['source'], 'Careers')",
                                  "linkedin": "@body('Parse_extract_response')?['linkedin']",
                                  "portfolio_url": "@body('Parse_extract_response')?['portfolio_url']",
                                  "current_location": "@body('Parse_extract_response')?['current_location']",
                                  "dob": "@body('Parse_extract_response')?['dob']",
                                  "last_role": "@body('Parse_extract_response')?['last_role']",
                                  "last_company": "@body('Parse_extract_response')?['last_company']",
                                  "total_experience_years": "@body('Parse_extract_response')?['total_experience_years']",
                                  "skills": "@body('Parse_extract_response')?['skills']",
                                  "notice_period": "@body('Parse_extract_response')?['notice_period']",
                                  "expected_salary": "@body('Parse_extract_response')?['expected_salary']",
                                  "current_salary": "@body('Parse_extract_response')?['current_salary']",
                                  "experience_json": "@string(coalesce(body('Parse_extract_response')?['experience'], json('[]')))",
                                  "education_json": "@string(coalesce(body('Parse_extract_response')?['education'], json('[]')))",
                                  "source_message_id": "@variables('MessageId')"
                                },
                                "host": {
                                  "connection": {
                                    "name": "@parameters('$connections')['sql']['connectionId']"
                                  }
                                },
                                "method": "post",
                                "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('default'))},@{encodeURIComponent(encodeURIComponent('default'))}/procedures/@{encodeURIComponent(encodeURIComponent('[dbo].[sp_intake_add_candidate]'))}"
                              },
                              "type": "ApiConnection"
                            }
                          }
                        },
                        "expression": {
                          "and": [
                            {
                              "greater": [
                                "@length(body('Filter_array'))",
                                0
                              ]
                            }
                          ]
                        },
                        "type": "If",
                        "runAfter": {}
                      }
                    },
                    "else": {
                      "actions": {
                        "Append_extra_doc": {
                          "type": "AppendToArrayVariable",
                          "runAfter": {},
                          "inputs": {
                            "name": "ExtraDocs",
                            "value": {
                              "name": "@body('Get_Attachment_(V2)')?['name']",
                              "url": "@if(equals(actions('Create_blob')?['status'], 'Succeeded'), concat('https://turnbhrmscvs.blob.core.windows.net/candidate-cvs/', encodeURIComponent(outputs('Blob_name'))), body('Create_sharing_link_for_a_file_or_folder')?['link']?['webUrl'])",
                              "document_type": "@coalesce(body('Parse_extract_response')?['document_type'], 'cover_letter')",
                              "email": "@body('Parse_extract_response')?['email']"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "else": {
                  "actions": {}
                },
                "expression": {
                  "or": [
                    {
                      "endsWith": [
                        "@toLower(body('Get_Attachment_(V2)')?['name'])",
                        ".pdf"
                      ]
                    },
                    {
                      "endsWith": [
                        "@toLower(body('Get_Attachment_(V2)')?['name'])",
                        ".docx"
                      ]
                    },
                    {
                      "endsWith": [
                        "@toLower(body('Get_Attachment_(V2)')?['name'])",
                        ".doc"
                      ]
                    }
                  ]
                },
                "runAfter": {
                  "Get_Attachment_(V2)": [
                    "Succeeded"
                  ]
                },
                "type": "If"
              },
              "Get_Attachment_(V2)": {
                "inputs": {
                  "host": {
                    "connection": {
                      "name": "@parameters('$connections')['office365-2']['connectionId']"
                    }
                  },
                  "method": "get",
                  "path": "/codeless/v1.0/me/messages/@{encodeURIComponent(triggerBody()?['id'])}/attachments/@{encodeURIComponent(item()?['id'])}"
                },
                "type": "ApiConnection"
              }
            },
            "foreach": "@triggerBody()?['attachments']",
            "runAfter": {
              "Html_to_text": [
                "Succeeded"
              ]
            },
            "runtimeConfiguration": {
              "concurrency": {
                "repetitions": 1
              }
            },
            "type": "Foreach"
          },
          "Html_to_text": {
            "inputs": {
              "body": "<p class=\"editor-paragraph\">@{triggerBody()?['body']}@{triggerBody()?['subject']}</p>",
              "host": {
                "connection": {
                  "name": "@parameters('$connections')['conversionservice-1']['connectionId']"
                }
              },
              "method": "post",
              "path": "/html2text"
            },
            "type": "ApiConnection"
          },
          "Condition_Has_ExtraDocs": {
            "type": "If",
            "runAfter": {
              "For_each": [
                "Succeeded"
              ]
            },
            "expression": {
              "and": [
                {
                  "greater": [
                    "@length(variables('ExtraDocs'))",
                    0
                  ]
                }
              ]
            },
            "actions": {
              "Execute_attachments_procedure": {
                "inputs": {
                  "body": {
                    "source_message_id": "@variables('MessageId')",
                    "attachments_json": "@{string(variables('ExtraDocs'))}"
                  },
                  "host": {
                    "connection": {
                      "name": "@parameters('$connections')['sql']['connectionId']"
                    }
                  },
                  "method": "post",
                  "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('default'))},@{encodeURIComponent(encodeURIComponent('default'))}/procedures/@{encodeURIComponent(encodeURIComponent('[dbo].[sp_intake_add_attachments]'))}"
                },
                "type": "ApiConnection"
              }
            },
            "else": {
              "actions": {}
            }
          }
        },
        "else": {
          "actions": {}
        },
        "expression": {
          "and": [
            {
              "not": {
                "endsWith": [
                  "@triggerBody()?['from']",
                  "indeedemail.com"
                ]
              }
            },
            {
              "not": {
                "startsWith": [
                  "@triggerBody()?['subject']",
                  "Off-Campus Recruitment Drive"
                ]
              }
            }
          ]
        },
        "runAfter": {
          "Initialize_ExtraDocs": [
            "Succeeded"
          ]
        },
        "type": "If"
      }
    },
    "outputs": {},
    "parameters": {
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      },
      "djangoApiUrl": {
        "defaultValue": "https://turnb-ats.azurewebsites.net/api/cv/extract/",
        "type": "String"
      },
      "djangoApiKey": {
        "defaultValue": "",
        "type": "SecureString"
      }
    }
  },
  "parameters": {
    "$connections": {
      "type": "Object",
      "value": {
        "azureblob": {
          "connectionId": "/subscriptions/32ea51d0-6a7d-4a16-ab91-4f5f80f708c7/resourceGroups/HRMS/providers/Microsoft.Web/connections/azureblob",
          "connectionName": "azureblob",
          "connectionProperties": {},
          "id": "/subscriptions/32ea51d0-6a7d-4a16-ab91-4f5f80f708c7/providers/Microsoft.Web/locations/centralindia/managedApis/azureblob"
        },
        "conversionservice-1": {
          "connectionId": "/subscriptions/32ea51d0-6a7d-4a16-ab91-4f5f80f708c7/resourceGroups/HRMS/providers/Microsoft.Web/connections/conversionservice",
          "connectionName": "conversionservice",
          "connectionProperties": {},
          "id": "/subscriptions/32ea51d0-6a7d-4a16-ab91-4f5f80f708c7/providers/Microsoft.Web/locations/centralindia/managedApis/conversionservice"
        },
        "excelonlinebusiness": {
          "connectionId": "/subscriptions/32ea51d0-6a7d-4a16-ab91-4f5f80f708c7/resourceGroups/HRMS/providers/Microsoft.Web/connections/excelonlinebusiness",
          "connectionName": "excelonlinebusiness",
          "connectionProperties": {},
          "id": "/subscriptions/32ea51d0-6a7d-4a16-ab91-4f5f80f708c7/providers/Microsoft.Web/locations/centralindia/managedApis/excelonlinebusiness"
        },
        "office365": {
          "connectionId": "/subscriptions/32ea51d0-6a7d-4a16-ab91-4f5f80f708c7/resourceGroups/HRMS/providers/Microsoft.Web/connections/office365",
