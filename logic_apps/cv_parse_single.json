{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "When_a_HTTP_request_is_received": {
                "type": "Request",
                "kind": "Http",
                "inputs": {
                    "method": "POST",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "filename": {
                                "type": "string"
                            },
                            "content_base64": {
                                "type": "string"
                            },
                            "role_hint": {
                                "type": "string"
                            },
                            "source_hint": {
                                "type": "string"
                            },
                            "upload_to_sharepoint": {
                                "type": "boolean"
                            }
                        },
                        "required": [
                            "filename",
                            "content_base64"
                        ]
                    }
                }
            }
        },
        "actions": {
            "Parse_CV": {
                "type": "Scope",
                "runAfter": {},
                "actions": {
                    "Should_upload_to_SharePoint": {
                        "type": "If",
                        "runAfter": {},
                        "expression": {
                            "and": [
                                {
                                    "not": {
                                        "equals": [
                                            "@coalesce(triggerBody()?['upload_to_sharepoint'], true)",
                                            false
                                        ]
                                    }
                                }
                            ]
                        },
                        "actions": {
                            "Create_file_1": {
                                "type": "ApiConnection",
                                "runAfter": {},
                                "runtimeConfiguration": {
                                    "contentTransfer": {
                                        "transferMode": "Chunked"
                                    }
                                },
                                "inputs": {
                                    "host": {
                                        "connection": {
                                            "name": "@parameters('$connections')['sharepointonline-1']['connectionId']"
                                        }
                                    },
                                    "method": "post",
                                    "body": "@base64ToBinary(triggerBody()?['content_base64'])",
                                    "path": "/datasets/@{encodeURIComponent(encodeURIComponent('https://netorg519925.sharepoint.com/sites/TeamHR'))}/files",
                                    "queries": {
                                        "folderPath": "/Shared Documents/General/HR - Docs/TurnB - HR/Recruitment/Resume Received",
                                        "name": "@triggerBody()?['filename']",
                                        "queryParametersSingleEncoded": true
                                    }
                                }
                            },
                            "Create_sharing_link_for_a_file_or_folder": {
                                "type": "ApiConnection",
                                "runAfter": {
                                    "Create_file_1": [
                                        "Succeeded"
                                    ]
                                },
                                "inputs": {
                                    "host": {
                                        "connection": {
                                            "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                                        }
                                    },
                                    "method": "post",
                                    "body": {
                                        "type": "edit",
                                        "scope": "organization"
                                    },
                                    "path": "/datasets/@{encodeURIComponent(encodeURIComponent('https://netorg519925.sharepoint.com/sites/TeamHR'))}/codeless/_api/v2.0/sites/root/lists/@{encodeURIComponent(encodeURIComponent('55178891-31a8-46cc-9a03-23970fab1fcd'))}/items/@{encodeURIComponent(encodeURIComponent(body('Create_file_1')?['ItemId']))}/driveItem/createLink"
                                }
                            }
                        },
                        "else": {
                            "actions": {}
                        }
                    }
                }
            },
            "CV_link": {
                "type": "Compose",
                "runAfter": {
                    "Parse_CV": [
                        "Succeeded",
                        "Failed",
                        "TimedOut"
                    ]
                },
                "inputs": "@coalesce(body('Create_sharing_link_for_a_file_or_folder')?['link']?['webUrl'], '')"
            },
            "Respond": {
                "type": "If",
                "runAfter": {
                    "CV_link": [
                        "Succeeded"
                    ]
                },
                "expression": {
                    "or": [
                        {
                            "not": {
                                "equals": [
                                    "@outputs('CV_link')",
                                    ""
                                ]
                            }
                        },
                        {
                            "equals": [
                                "@coalesce(triggerBody()?['upload_to_sharepoint'], true)",
                                false
                            ]
                        }
                    ]
                },
                "actions": {
                    "Response_Success": {
                        "type": "Response",
                        "kind": "Http",
                        "runAfter": {},
                        "inputs": {
                            "statusCode": 200,
                            "headers": {
                                "Content-Type": "application/json"
                            },
                            "body": {
                                "status": "ok",
                                "CV_Link": "@{outputs('CV_link')}"
                            }
                        }
                    }
                },
                "else": {
                    "actions": {
                        "Failed_actions": {
                            "type": "Query",
                            "runAfter": {},
                            "inputs": {
                                "from": "@result('Parse_CV')",
                                "where": "@equals(item()?['status'], 'Failed')"
                            }
                        },
                        "Response_Error": {
                            "type": "Response",
                            "kind": "Http",
                            "runAfter": {
                                "Failed_actions": [
                                    "Succeeded",
                                    "Failed",
                                    "Skipped",
                                    "TimedOut"
                                ]
                            },
                            "inputs": {
                                "statusCode": 200,
                                "headers": {
                                    "Content-Type": "application/json"
                                },
                                "body": {
                                    "status": "error",
                                    "action": "@{first(body('Failed_actions'))?['name']}",
                                    "message": "@{coalesce(first(body('Failed_actions'))?['error']?['message'], first(body('Failed_actions'))?['outputs']?['body']?['error']?['message'], 'Could not file this CV to SharePoint.')}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "outputs": {},
        "parameters": {
            "$connections": {
                "type": "Object",
                "defaultValue": {}
            }
        }
    },
    "parameters": {
        "$connections": {
            "type": "Object",
            "value": {
                "sharepointonline-1": {
                    "id": "/subscriptions/0300da4d-3a63-4241-a129-42b4f8b0c5cc/providers/Microsoft.Web/locations/centralindia/managedApis/sharepointonline",
                    "connectionId": "/subscriptions/0300da4d-3a63-4241-a129-42b4f8b0c5cc/resourceGroups/HRMS/providers/Microsoft.Web/connections/sharepointonline-2",
                    "connectionName": "sharepointonline-2",
                    "connectionProperties": {}
                },
                "sharepointonline": {
                    "id": "/subscriptions/0300da4d-3a63-4241-a129-42b4f8b0c5cc/providers/Microsoft.Web/locations/centralindia/managedApis/sharepointonline",
                    "connectionId": "/subscriptions/0300da4d-3a63-4241-a129-42b4f8b0c5cc/resourceGroups/HRMS/providers/Microsoft.Web/connections/sharepointonline-2",
                    "connectionName": "sharepointonline-2",
                    "connectionProperties": {}
                }
            }
        }
    }
}
