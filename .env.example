# Copy this file to ".env" and fill in real values. NEVER commit ".env".

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# ---- Database ----
# DB_ENGINE options: sqlite (default) | azure | postgres
#
# Azure SQL (what this project uses):
#   DB_ENGINE=azure
#   DB_NAME=hr_recruitment
#   DB_USER=<sql admin login>
#   DB_PASSWORD=<sql admin password>
#   DB_HOST=<yourserver>.database.windows.net
#   DB_PORT=1433
#
# Postgres:
#   DB_ENGINE=postgres  (+ DB_NAME/DB_USER/DB_PASSWORD/DB_HOST/DB_PORT)

DB_ENGINE=sqlite
DB_NAME=hr_recruitment
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=1433

# ---- Bulk Upload CV: the cv-parse-single Logic App ----
# HTTP POST URL of the Logic App trigger (contains a SAS signature - secret).
# Setup instructions: logic_apps/README.md. Leave blank to disable CV reading.
LOGIC_APP_CV_PARSER_URL=
# CV_PARSER_TIMEOUT=180
# CV_PARSER_UPLOAD_TO_SHAREPOINT=True
# BULK_UPLOAD_MAX_FILES=25
# BULK_UPLOAD_MAX_MB=10

# ---- Score Candidates: direct Azure OpenAI call (same resource as above) ----
# Endpoint + key of the Azure OpenAI resource (Azure Portal -> your resource ->
# Keys and Endpoint). Leave blank to disable the Score Candidates tab.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
# AZURE_OPENAI_SCORING_DEPLOYMENT=cv-data-agent
# AZURE_OPENAI_API_VERSION=2024-02-01
# SCORE_CANDIDATES_TIMEOUT=60

# ---- Email (interview invites, etc.) ----
# Leave EMAIL_HOST blank to keep the console backend - emails print to the
# server log instead of sending, so nothing here is required for local dev.
# For real delivery, set EMAIL_BACKEND to the SMTP backend and fill in the
# careers@turnb.com mailbox's SMTP AUTH credentials:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.office365.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=careers@turnb.com
#   EMAIL_HOST_PASSWORD=<mailbox password or app password>
#   EMAIL_USE_TLS=True
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=hr@example.com

# From/CC on interview invite emails sent from a candidate's profile page.
# INTERVIEW_INVITE_FROM_EMAIL=careers@turnb.com
# INTERVIEW_INVITE_CC_EMAIL=Amrita.Sunilkumar@turnb.com
