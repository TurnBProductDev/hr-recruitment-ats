# Copy this file to ".env" and fill in real values. NEVER commit ".env".

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# ---- Database ----
# DB_ENGINE options: sqlite (default) | azure | postgres
#
# Azure SQL (what this project uses):
#   DB_ENGINE=azure
#   DB_NAME=hr_recruitment
#   DB_USER=<sql admin login>
#   DB_PASSWORD=<sql admin password>
#   DB_HOST=<yourserver>.database.windows.net
#   DB_PORT=1433
#
# Postgres:
#   DB_ENGINE=postgres  (+ DB_NAME/DB_USER/DB_PASSWORD/DB_HOST/DB_PORT)

DB_ENGINE=sqlite
DB_NAME=hr_recruitment
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=1433

# ---- Bulk Upload CV: the cv-parse-single Logic App ----
# HTTP POST URL of the Logic App trigger (contains a SAS signature - secret).
# Setup instructions: logic_apps/README.md. Leave blank to disable CV reading.
LOGIC_APP_CV_PARSER_URL=
# CV_PARSER_TIMEOUT=180
# CV_PARSER_UPLOAD_TO_SHAREPOINT=True
# BULK_UPLOAD_MAX_FILES=25
# BULK_UPLOAD_MAX_MB=10
